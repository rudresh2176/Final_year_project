// TransMonitor - Transformer Monitoring & Fault Classification System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Transformer configuration and identity
model Transformer {
  id              String   @id @default(cuid()) @map("_id")
  transformerId   String   @unique // TX001, TX002, etc.
  name            String   @default("Untitled Transformer")
  kva             Float
  primaryVoltage  Float
  secondaryVoltage Float
  location        String   @default("N/A")
  phase           String   @default("single")
  status          String   @default("Online")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs            DataLog[]
}

// Data log entry from transformer monitoring
model DataLog {
  id                String      @id @default(cuid()) @map("_id")
  transformerId     String      @default("UNKNOWN")
  transformer       Transformer @relation(fields: [transformerId], references: [transformerId], onDelete: Cascade)
  
  // Denormalized transformer info for easy searching/filtering
  transformerName   String      @default("Unknown")
  location          String      @default("N/A")
  kva               Float       @default(0)
  
  timestamp         DateTime    @default(now())
  
  // Primary side (input) parameters
  primaryVoltage    Float    @default(0)
  primaryCurrent    Float    @default(0)
  primaryPower      Float    @default(0)
  primaryEnergy     Float    @default(0)
  primaryFrequency  Float    @default(0)
  primaryPowerFactor Float   @default(0)
  
  // Secondary side (output) parameters
  secondaryVoltage    Float    @default(0)
  secondaryCurrent    Float    @default(0)
  secondaryPower      Float    @default(0)
  secondaryEnergy     Float    @default(0)
  secondaryFrequency  Float    @default(0)
  secondaryPowerFactor Float   @default(0)
  
  // Calculated values
  loss            Float  @default(0)
  lossPercentage  Float  @default(0)
  loadPercentage  Float  @default(0)
  efficiency      Float  @default(0)
  
  // Status
  status     String  @default("OFFLINE")
  severity   String  @default("Normal")
  faultType  String?
  warnings   String?

  createdAt  DateTime @default(now())
}

// Notification entry
model Notification {
  id          String   @id @default(cuid()) @map("_id")
  type        String   @default("info")
  title       String
  message     String
  severity    String   @default("Low")
  isRead      Boolean  @default(false)
  faults      String?
  warnings    String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
}
