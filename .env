# Local development: SQLite file database
DATABASE_URL=file:db/custom.db

# ─── Production (set these in your deployment platform's environment variables) ───
# Option 1: Turso (libSQL cloud database)
#   DATABASE_URL=file:local.db
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=your-auth-token
#
# Option 2: Any cloud SQLite provider
#   DATABASE_URL=file:local.db
#
# Note: For serverless deployment without persistent storage,
# Data History will show empty (graceful degradation).
